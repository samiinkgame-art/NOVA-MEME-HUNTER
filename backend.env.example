# Set these in the backend hosting service, not in index.html.
# Required secret: generate in the dashboard with Generate setup key,
# then copy the same value into NOVA_ADMIN_KEY in the backend host settings.
NOVA_ADMIN_KEY=
# Exact HTTPS dashboard origin, without /path or trailing slash.
NOVA_DASHBOARD_ORIGIN=
PORT=8000
NOVA_DB=/data/nova-research-0.1.1.db
NOVA_MODE=scanner
# Opt-in to simulated experiments with UNKNOWN on-chain security:
NOVA_AUTO_PAPER_RESEARCH=false
NOVA_SCAN_SECONDS=60
NOVA_STALE_SECONDS=180
NOVA_INITIAL_CASH=10000
NOVA_RISK_PER_TRADE=0.005
NOVA_MAX_POSITION=0.05
NOVA_MAX_EXPOSURE=0.20
NOVA_DAILY_LOSS=0.03
NOVA_WEEKLY_LOSS=0.06
NOVA_MAX_DRAWDOWN=0.10
NOVA_MIN_LIQUIDITY=100000
NOVA_MAX_PARTICIPATION=0.001
NOVA_SLIPPAGE_BPS=50
NOVA_FEE_BPS=30
NOVA_MAX_SLIPPAGE_BPS=100
NOVA_LOSS_STREAK=3
NOVA_COOLDOWN_SECONDS=3600
NOVA_WATCHLIST=So11111111111111111111111111111111111111112
